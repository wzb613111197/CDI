<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    controllerName="com.cathaydining.zsdi001.ext.controller.Home">
    <f:DynamicPage showFooter="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{@i18n>appTitle}"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="sapUiMediumMargin" width="auto">
                <Panel headerText="{@i18n>SelectBy}" class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <RadioButtonGroup id="optionGroup" selectedIndex="0" class="sapUiSmallMarginBottom">
                            <RadioButton id="rbMaterial" text="{@i18n>ByMaterial}"/>
                            <RadioButton id="rbLoadTemp" text="{@i18n>ByLoadingTemplate}"/>
                        </RadioButtonGroup>
                        <Button id="homeNextBtn" text="{@i18n>Next}" type="Emphasized" press=".onExecute" class="sapUiSmallMarginTop"/>
                    </VBox>
                </Panel>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
