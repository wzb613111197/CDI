{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.cathaydining.zppf004",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "b4a4855b-5e9a-4984-9b53-9354d7eb3227"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_pp_crew_info_o4/srvd/sap/zsd_pp_crew_info/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.se.mi.plm.lib.attachmentservice": {
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cathaydining.zppf004.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "CrewInfoList",
          "target": "CrewInfoList"
        },
        {
          "pattern": "CrewInfo({key}):?query:",
          "name": "CrewInfoObjectPage",
          "target": "CrewInfoObjectPage"
        }
      ],
      "targets": {
        "CrewInfoList": {
          "type": "Component",
          "id": "CrewInfoList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/CrewInfo",
              "variantManagement": "Page",
              "navigation": {
                "CrewInfo": {
                  "detail": {
                    "route": "CrewInfoObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "Print": {
                      "press": ".extension.com.cathaydining.zppf004.ext.controller.ListReportExtension.onPrint",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "{i18n>Print}"
                    },
                    "PreView": {
                      "press": ".extension.com.cathaydining.zppf004.ext.controller.ListReportExtension.onPreView",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "{i18n>PreView}"
                    }
                  }
                }
              }
            }
          }
        },
        "CrewInfoObjectPage": {
          "type": "Component",
          "id": "CrewInfoObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/CrewInfo",
              "content": {
                "body": {
                  "sections": {
                    "AttachmentsSection": {
                      "title": "{@i18n>Attachments}",
                      "position": {
                        "placement": "After",
                        "anchor": "Other"
                      },
                      "embeddedComponent": {
                        "name": "sap.se.mi.plm.lib.attachmentservice.attachment.components.fscomponent",
                        "settings": {
                          "mode": "{= ${ui>/isEditable} ? 'C' : 'D'}",
                          "objectType": "ZCREW_INFO",
                          "objectKey": "{parts:[{path:'ZciNumber'},{path:'IsActiveEntity'}], formatter:'com.cathaydining.zppf004.ext.formatter.attachmentKey'}",
                          "isGuid": false,
                          "isDraft": "{= ${IsActiveEntity}}",
                          "attributeHandling": {
                            "_VisibleAttributes": {
                              "UPLOADEDBY": true,
                              "UPLOADEDON": true,
                              "FILESIZE": true,
                              "ENABLELINK": true,
                              "ATTACHMENTSTATUS": true,
                              "ATTACHMENTTITLE": true,
                              "SOURCE": true,
                              "DIRDETAILS": true
                            },
                            "_VisibleActions": {
                              "RENAME": true,
                              "DELETE": true,
                              "ADD": true,
                              "ADDURL": false,
                              "DOWNLOAD": true
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "com.cathaydining.zppf004.ext.controller.ListReportExtension"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "com.cathaydining.zppf004.ext.controller.ObjectPageExtension"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
