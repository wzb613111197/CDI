{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.cathaydining.zsde005.createquo",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "e056bb81-b55d-47b8-b113-fe2a634eea2f"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_sd_qt_load_temp_o4/srvd/sap/zsd_sd_qt_load_temp/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.table": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cathaydining.zsde005.createquo.i18n.i18n",
          "supportedLocales": [
            "",
            "zh_CN",
            "zh_TW"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "Home",
          "target": "Home"
        },
        {
          "pattern": "ZI_SD_QT_MATERIAL:?query:",
          "name": "ZI_SD_QT_MATERIALList",
          "target": "ZI_SD_QT_MATERIALList"
        },
        {
          "pattern": "ZI_SD_QT_LOAD_TEMP:?query:",
          "name": "ZI_SD_QT_LOAD_TEMPList",
          "target": "ZI_SD_QT_LOAD_TEMPList"
        }
      ],
      "targets": {
        "Home": {
          "type": "Component",
          "id": "Home",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "viewName": "com.cathaydining.zsde005.createquo.ext.view.Home"
            }
          }
        },
        "ZI_SD_QT_MATERIALList": {
          "type": "Component",
          "id": "ZI_SD_QT_MATERIALList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZI_SD_QT_MATERIAL",
              "variantManagement": "Page",
              "navigation": {},
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectAll": true,
                    "selectionMode": "Multi",
                    "widthIncludingColumnHeader": true,
                    "requestAtLeast": "CostRunDate,Customer,AirlineCode,NewCost,CP,DistChannel,Division,BomEffectiveDate"
                  },
                  "actions": {
                    "MaterialNewQuotation": {
                      "press": ".extension.com.cathaydining.zsde005.createquo.ext.controller.ListReportExtension.onMaterialNewQuotation",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "{@i18n>newQuotationButton}"
                    }
                  }
                }
              }
            }
          }
        },
        "ZI_SD_QT_LOAD_TEMPList": {
          "type": "Component",
          "id": "ZI_SD_QT_LOAD_TEMPList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZI_SD_QT_LOAD_TEMP",
              "variantManagement": "Page",
              "navigation": {},
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectAll": true,
                    "selectionMode": "Multi",
                    "widthIncludingColumnHeader": true
                  },
                  "actions": {
                    "LoadingTemplateNewQuotation": {
                      "press": ".extension.com.cathaydining.zsde005.createquo.ext.controller.ListReportExtension.onLoadingTemplateNewQuotation",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "{@i18n>newQuotationButton}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "com.cathaydining.zsde005.createquo.ext.controller.ListReportExtension"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
