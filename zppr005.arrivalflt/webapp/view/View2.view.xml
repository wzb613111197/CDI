<mvc:View
    controllerName="com.cathaydining.zppr005.arrivalflt.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="boardPage"
        showHeader="false"
        class="arrivalBoardPage"
    >
        <content>
            <VBox class="arrivalBoardRoot fitContainer">
                <Text
                    text="{i18n>boardTitle}"
                    class="boardTopTitle"
                />
                <HBox
                    class="boardTopBar"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="{= ${board>/airlineGrp} ? ${i18n>boardAirport} + ' (' + ${board>/airlineGrp} + ')' : ${i18n>boardAirport} }"
                        class="boardTopBadgeValue"
                    />
                    <Text
                        text="{board>/dateText}"
                        class="boardTopDate"
                    />
                    <Text
                        text="{board>/timeText}"
                        class="boardTopTime"
                    />
                </HBox>
                <HBox id="arrivalBoardTable" class="boardTripleTableBox">
                    <Table
                        class="arrivalTable boardTripleTable"
                        fixedLayout="Strict"
                        items="{board>/pagedFlightsLeft}"
                    >
                        <columns>
                            <Column width="28%">
                                <header>
                                    <Text text="{i18n>colFlightNumber}" />
                                </header>
                            </Column>
                            <Column width="22%">
                                <header>
                                    <Text text="{i18n>colTailNumber}" />
                                </header>
                            </Column>
                            <Column width="22%">
                                <header>
                                    <Text text="{i18n>colParking}" />
                                </header>
                            </Column>
                            <Column width="28%">
                                <header>
                                    <Text text="{i18n>colEta}" />
                                </header>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle" type="Inactive">
                                <cells>
                                    <Text
                                        text="{path: 'board>FlightNumber', formatter: '.formatFlightNumber'}"
                                        class="boardCellText boardCellBold"
                                    />
                                    <ObjectStatus
                                        text="{board>TailNumber}"
                                        state="{path: 'board>_change_TailNumber', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell"
                                    />
                                    <ObjectStatus
                                        text="{board>ParkingBay}"
                                        state="{path: 'board>_change_ParkingBay', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell"
                                    />
                                    <ObjectStatus
                                        text="{path: 'board>InbEtaTime', formatter: '.formatTimeHHMM'}"
                                        state="{path: 'board>_change_InbEtaTime', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell boardEtaCell"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <Table
                        class="arrivalTable boardTripleTable"
                        fixedLayout="Strict"
                        items="{board>/pagedFlightsMiddle}"
                    >
                        <columns>
                            <Column width="28%">
                                <header>
                                    <Text text="{i18n>colFlightNumber}" />
                                </header>
                            </Column>
                            <Column width="22%">
                                <header>
                                    <Text text="{i18n>colTailNumber}" />
                                </header>
                            </Column>
                            <Column width="22%">
                                <header>
                                    <Text text="{i18n>colParking}" />
                                </header>
                            </Column>
                            <Column width="28%">
                                <header>
                                    <Text text="{i18n>colEta}" />
                                </header>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle" type="Inactive">
                                <cells>
                                    <Text
                                        text="{path: 'board>FlightNumber', formatter: '.formatFlightNumber'}"
                                        class="boardCellText boardCellBold"
                                    />
                                    <ObjectStatus
                                        text="{board>TailNumber}"
                                        state="{path: 'board>_change_TailNumber', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell"
                                    />
                                    <ObjectStatus
                                        text="{board>ParkingBay}"
                                        state="{path: 'board>_change_ParkingBay', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell"
                                    />
                                    <ObjectStatus
                                        text="{path: 'board>InbEtaTime', formatter: '.formatTimeHHMM'}"
                                        state="{path: 'board>_change_InbEtaTime', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell boardEtaCell"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <Table
                        class="arrivalTable boardTripleTable"
                        fixedLayout="Strict"
                        items="{board>/pagedFlightsRight}"
                    >
                        <columns>
                            <Column width="28%">
                                <header>
                                    <Text text="{i18n>colFlightNumber}" />
                                </header>
                            </Column>
                            <Column width="22%">
                                <header>
                                    <Text text="{i18n>colTailNumber}" />
                                </header>
                            </Column>
                            <Column width="22%">
                                <header>
                                    <Text text="{i18n>colParking}" />
                                </header>
                            </Column>
                            <Column width="28%">
                                <header>
                                    <Text text="{i18n>colEta}" />
                                </header>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle" type="Inactive">
                                <cells>
                                    <Text
                                        text="{path: 'board>FlightNumber', formatter: '.formatFlightNumber'}"
                                        class="boardCellText boardCellBold"
                                    />
                                    <ObjectStatus
                                        text="{board>TailNumber}"
                                        state="{path: 'board>_change_TailNumber', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell"
                                    />
                                    <ObjectStatus
                                        text="{board>ParkingBay}"
                                        state="{path: 'board>_change_ParkingBay', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell"
                                    />
                                    <ObjectStatus
                                        text="{path: 'board>InbEtaTime', formatter: '.formatTimeHHMM'}"
                                        state="{path: 'board>_change_InbEtaTime', formatter: '.formatCellState'}"
                                        inverted="true"
                                        class="boardStatusCell boardEtaCell"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </HBox>

                <HBox
                    class="boardFooterBar"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <HBox
                        alignItems="Center"
                        class="boardFooterSection"
                    >
                        <Text
                            text="{i18n>legendVersion}"
                            class="boardFooterSectionTitle"
                        />
                        <HBox
                            alignItems="Center"
                            class="boardLegendGroup"
                        >
                            <HBox
                                alignItems="Center"
                                class="boardLegendItem"
                            >
                                <Text
                                    text=""
                                    class="boardLegendSwatch boardLegendSwatchGreen"
                                />
                                <Text
                                    text="{i18n>legendFirst}"
                                    class="boardFooterLabel"
                                />
                            </HBox>
                            <HBox
                                alignItems="Center"
                                class="boardLegendItem"
                            >
                                <Text
                                    text=""
                                    class="boardLegendSwatch boardLegendSwatchYellow"
                                />
                                <Text
                                    text="{i18n>legendSecond}"
                                    class="boardFooterLabel"
                                />
                            </HBox>
                            <HBox
                                alignItems="Center"
                                class="boardLegendItem"
                            >
                                <Text
                                    text=""
                                    class="boardLegendSwatch boardLegendSwatchRed"
                                />
                                <Text
                                    text="{i18n>legendThird}"
                                    class="boardFooterLabel"
                                />
                            </HBox>
                        </HBox>
                    </HBox>
                    <HBox
                        alignItems="Center"
                        class="boardFooterSection boardFooterSectionRight"
                    >
                        <Text
                            text="{i18n>pageLabel}"
                            class="boardFooterSectionTitle"
                        />
                        <Text
                            text="{board>/pageText}"
                            class="boardFooterPage"
                        />
                    </HBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
