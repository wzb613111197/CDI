<mvc:View
    controllerName="com.cathaydining.zppr005.departureflt.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="departureBoardPage"
        showHeader="false"
        class="departureBoardPage"
    >
        <content>
            <VBox class="departureBoardRoot fitContainer">
                <Text
                    text="{i18n>boardTitle}"
                    class="boardTopTitle"
                />
                <HBox
                    class="boardTopBar"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="{= ${board>/airlineGrp} ? ${i18n>boardAirport} + ' (' + ${board>/airlineGrp} + ')' : ${i18n>boardAirport} }"
                        class="boardTopBadgeValue"
                    />
                    <Text
                        text="{board>/dateText}"
                        class="boardTopDate"
                    />
                    <Text
                        text="{board>/timeText}"
                        class="boardTopTime"
                    />
                </HBox>
                <Table
                    id="departureBoardTable"
                    class="departureTable"
                    fixedLayout="Strict"
                    items="{board>/pagedFlights}"
                >
                    <columns>
                        <Column width="12%">
                            <header>
                                <Text text="{i18n>colFlightNumber}" />
                            </header>
                        </Column>
                        <Column width="11%">
                            <header>
                                <Text text="{i18n>colAircraftType}" />
                            </header>
                        </Column>
                        <Column width="13%">
                            <header>
                                <Text text="{i18n>colTailNumber}" />
                            </header>
                        </Column>
                        <Column width="10%">
                            <header>
                                <Text text="{i18n>colParkingBay}" />
                            </header>
                        </Column>
                        <Column width="9%">
                            <header>
                                <Text text="{i18n>colEta}" />
                            </header>
                        </Column>
                        <Column width="9%">
                            <header>
                                <Text text="{i18n>colEtd}" />
                            </header>
                        </Column>
                        <Column width="9%">
                            <header>
                                <Text text="{i18n>colDestination}" />
                            </header>
                        </Column>
                        <Column width="10%">
                            <header>
                                <Text text="{i18n>colStatus}" />
                            </header>
                        </Column>
                        <Column width="17%">
                            <header>
                                <Text text="{i18n>colRemark}" />
                            </header>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            vAlign="Middle"
                            type="Inactive"
                        >
                            <cells>
                                <Text
                                    text="{path: 'board>FlightNumber', formatter: '.formatFlightNumber'}"
                                    class="boardCellText boardCellBold"
                                />
                                <ObjectStatus
                                    text="{board>AircraftType}"
                                    state="{path: 'board>_change_AircraftType', formatter: '.formatCellState'}"
                                    inverted="true"
                                    class="boardStatusCell"
                                />
                                <ObjectStatus
                                    text="{board>TailNumber}"
                                    state="{path: 'board>_change_TailNumber', formatter: '.formatCellState'}"
                                    inverted="true"
                                    class="boardStatusCell"
                                />
                                <ObjectStatus
                                    text="{board>ParkingBay}"
                                    state="{path: 'board>_change_ParkingBay', formatter: '.formatCellState'}"
                                    inverted="true"
                                    class="boardStatusCell"
                                />
                                <ObjectStatus
                                    text="{path: 'board>ETATime', formatter: '.formatTimeHHMM'}"
                                    state="{path: 'board>_change_ETATime', formatter: '.formatCellState'}"
                                    inverted="true"
                                    class="boardStatusCell boardEtaCell"
                                />
                                <ObjectStatus
                                    text="{parts: ['board>ETDTime', 'board>STDRaw', 'board>OpsStatus'], formatter: '.formatETDTime'}"
                                    state="{path: 'board>_change_ETDTime', formatter: '.formatCellState'}"
                                    inverted="true"
                                    class="boardStatusCell"
                                />
                                <ObjectStatus
                                    text="{board>Destination}"
                                    state="{path: 'board>_change_Destination', formatter: '.formatCellState'}"
                                    inverted="true"
                                    class="boardStatusCell"
                                />
                                <ObjectStatus
                                    text="{board>OpsStatus}"
                                    state="{path: 'board>_change_OpsStatus', formatter: '.formatCellState'}"
                                    inverted="true"
                                    class="boardStatusCell"
                                />
                                <ObjectStatus
                                    text="{board>Remark}"
                                    state="{path: 'board>_change_Remark', formatter: '.formatCellState'}"
                                    inverted="true"
                                    class="boardStatusCell boardRemarkCell"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <HBox
                    class="boardFooterBar"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <HBox
                        alignItems="Center"
                        class="boardFooterSection"
                    >
                        <Text
                            text="{i18n>legendVersion}"
                            class="boardFooterSectionTitle"
                        />
                        <HBox
                            alignItems="Center"
                            class="boardLegendGroup"
                        >
                            <HBox
                                alignItems="Center"
                                class="boardLegendItem"
                            >
                                <Text
                                    text=""
                                    class="boardLegendSwatch boardLegendSwatchGreen"
                                />
                                <Text
                                    text="{i18n>legendFirst}"
                                    class="boardFooterLabel"
                                />
                            </HBox>
                            <HBox
                                alignItems="Center"
                                class="boardLegendItem"
                            >
                                <Text
                                    text=""
                                    class="boardLegendSwatch boardLegendSwatchYellow"
                                />
                                <Text
                                    text="{i18n>legendSecond}"
                                    class="boardFooterLabel"
                                />
                            </HBox>
                            <HBox
                                alignItems="Center"
                                class="boardLegendItem"
                            >
                                <Text
                                    text=""
                                    class="boardLegendSwatch boardLegendSwatchRed"
                                />
                                <Text
                                    text="{i18n>legendThird}"
                                    class="boardFooterLabel"
                                />
                            </HBox>
                        </HBox>
                    </HBox>
                    <HBox
                        alignItems="Center"
                        class="boardFooterSection boardFooterSectionRight"
                    >
                        <Text
                            text="{i18n>pageLabel}"
                            class="boardFooterSectionTitle"
                        />
                        <Text
                            text="{board>/pageText}"
                            class="boardFooterPage"
                        />
                    </HBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
