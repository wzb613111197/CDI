<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.core.Fragment"
    xmlns:ui="sap.ui.table"
>
    <m:Dialog
        id="printDialog"
        draggable="true"
        class="printDialog"
        contentHeight="500px"
        contentWidth="960px"
    >
        <m:customHeader>
            <m:Toolbar
                id="dlgToolbar"
                class="printDialogToolbar"
            >
                <m:Title
                    id="dialogTitle"
                    text="{i18n>printDialogTitle}"
                />
                <m:ToolbarSpacer id="dialogToolbarSpacer" />
                <m:Button
                    id="closeIconBtn"
                    icon="sap-icon://decline"
                    tooltip="{i18n>buttonClose}"
                    press="onClosePrintDialog"
                />
            </m:Toolbar>
        </m:customHeader>
        <m:content>
            <m:VBox
                id="dialogVBox"
                class="printDialogContent"
                renderType="Bare"
            >
                <m:Text
                    id="dialogSubtitle"
                    text="{i18n>printDialogSubtitle}"
                    class="sapUiTinyMarginBottom"
                />
                <m:HBox
                    id="printerSelectBox"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom"
                >
                    <m:Label
                        id="lblPrinter"
                        text="{i18n>labelPrinter}"
                        class="sapUiSmallMarginEnd"
                    />
                    <m:Input
                        id="printerInput"
                        value="{print>/printer}"
                        width="200px"
                    />
                </m:HBox>
                <m:Panel
                    id="dialogPanel"
                    class="printDialogPanel"
                    backgroundDesign="Transparent"
                >
                    <m:content>
                        <ui:Table
                            id="printTable"
                            rows="{print>/items}"
                            selectionMode="None"
                            width="100%"
                            class="printDialogTable"
                        >
                            <ui:rowSettingsTemplate>
                                <ui:RowSettings
                                    id="printTableRowSettings"
                                    highlight="{= ${print>RowType} === 'Group' ? 'Information' : 'None' }"
                                />
                            </ui:rowSettingsTemplate>
                            <ui:columns>
                                <ui:Column
                                    id="colProdOrder"
                                    width="14%"
                                >
                                    <m:Label
                                        id="lblColProdOrder"
                                        text="{i18n>tableColumnProdOrder}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtProdOrder"
                                            text="{= ${print>RowType} === 'Group' ? '' : ${print>ProductionOrder} }"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colMaterial"
                                    width="16%"
                                >
                                    <m:Label
                                        id="lblColMaterial"
                                        text="{i18n>tableColumnMaterial}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtMaterial"
                                            text="{print>MaterialCode}"
                                            wrapping="false"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colDescription"
                                    width="28%"
                                >
                                    <m:Label
                                        id="lblColDescription"
                                        text="{i18n>tableColumnDescription}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtDescription"
                                            text="{print>MaterialDescription}"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colQuantity"
                                    width="14%"
                                >
                                    <m:Label
                                        id="lblColQuantity"
                                        text="{i18n>tableColumnQuantity}"
                                    />
                                    <ui:template>
                                        <m:ObjectNumber
                                            id="txtQuantity"
                                            number="{= ${print>RowType} === 'Group' ? ${print>TotalQuantity} : ${print>ProdOrderBasedQuantity} }"
											unit="{print>ProdOrderUnit}"
                                            state="{= ${print>RowType} === 'Group' ? 'Information' : 'None' }"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colLabels"
                                    width="16%"
                                >
                                    <m:Label
                                        id="lblColLabels"
                                        text="{i18n>tableColumnLabels}"
                                    />
                                    <ui:template>
                                        <m:FlexBox id="labelsFlexBox" renderType="Bare" alignItems="Center">
                                            <m:ObjectNumber
                                                id="subtotalLabelsObj"
                                                number="{print>subtotalLabels}"
                                                state="Success"
                                                visible="{= ${print>RowType} === 'Group' }"
                                            />
                                            <m:Input
                                                id="labelInput"
                                                value="{print>NumberOfLabels}"
                                                type="Number"
                                                change="onNumberChange"
                                                visible="{= ${print>RowType} === 'Item' }"
                                            />
                                        </m:FlexBox>
                                    </ui:template>
                                </ui:Column>
                            </ui:columns>
                        </ui:Table>
                    </m:content>
                </m:Panel>
            </m:VBox>
        </m:content>
        <m:footer>
            <m:Toolbar
                id="dlgFooter"
                class="printDialogFooter"
            >
                <m:ToolbarSpacer id="footerSpacer" />
                <m:Button
                    id="PrintConfirmBtn"
                    text="{i18n>PrintConfirm}"
                    press="onPrintConfirm"
                    type="Emphasized"
                />
                <m:Button
                    id="closeBtn"
                    text="{i18n>buttonClose}"
                    press="onClosePrintDialog"
                />
            </m:Toolbar>
        </m:footer>
    </m:Dialog>
</core:FragmentDefinition>
