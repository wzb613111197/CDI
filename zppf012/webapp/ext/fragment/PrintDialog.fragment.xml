<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.core.Fragment"
    xmlns:ui="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
>
    <m:Dialog
        id="printDialog"
        draggable="true"
        class="printDialog"
        contentHeight="100%"
        contentWidth="100%"
    >
        <m:customHeader>
            <m:Toolbar
                id="dlgToolbar"
                class="printDialogToolbar"
            >
                <m:Title
                    id="dialogTitle"
                    text="{i18n>printDialogTitle}"
                />
                <m:ToolbarSpacer id="dialogToolbarSpacer" />
                <m:Button
                    id="closeIconBtn"
                    icon="sap-icon://decline"
                    tooltip="{i18n>buttonClose}"
                    press="onClosePrintDialog"
                />
            </m:Toolbar>
        </m:customHeader>
        <m:content>
            <m:VBox
                id="dialogVBox"
                class="printDialogContent"
                renderType="Bare"
            >
                <m:Panel
                    id="dialogPanel"
                    class="printDialogPanel"
                    backgroundDesign="Transparent"
                    headerText="{i18n>printDialogSubtitle}"
                >
                    <m:content>
                        <ui:Table
                            id="printTable"
                            rows="{print>/items}"
                            selectionMode="None"
                            width="100%"
                            class="printDialogTable"
                            rowsUpdated="onPrintTableRowsUpdated"
                        >
                            <ui:rowMode>
                                <rowmodes:Fixed id="printTableRowMode" rowCount="30" />
                            </ui:rowMode>
                            <ui:columns>
                                <ui:Column
                                    id="colProdOrder"
                                    width="11%"
                                >
                                    <m:Label
                                        id="lblColProdOrder"
                                        text="{i18n>tableColumnProdOrder}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtProdOrder"
                                            text="{= ${print>RowType} === 'Group' ? ${print>SubtotalText} : ${print>ProductionOrder} }"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colMaterial"
                                    width="10%"
                                >
                                    <m:Label
                                        id="lblColMaterial"
                                        text="{i18n>tableColumnMaterial}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtMaterial"
                                            text="{print>MaterialCode}"
                                            wrapping="false"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colDescription"
                                    width="16%"
                                >
                                    <m:Label
                                        id="lblColDescription"
                                        text="{i18n>tableColumnDescription}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtDescription"
                                            text="{print>MaterialDescription}"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colPlant"
                                    width="7%"
                                >
                                    <m:Label
                                        id="lblColPlant"
                                        text="{i18n>tableColumnPlant}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtPlant"
                                            text="{print>Plant}"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colZfevor"
                                    width="8%"
                                >
                                    <m:Label
                                        id="lblColZfevor"
                                        text="{i18n>tableColumnZfevor}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtZfevor"
                                            text="{print>Zfevor}"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colArbpl"
                                    width="8%"
                                >
                                    <m:Label
                                        id="lblColArbpl"
                                        text="{i18n>tableColumnArbpl}"
                                    />
                                    <ui:template>
                                        <m:Text
                                            id="txtArbpl"
                                            text="{print>Arbpl}"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colQuantity"
                                    width="10%"
                                >
                                    <m:Label
                                        id="lblColQuantity"
                                        text="{i18n>tableColumnQuantity}"
                                    />
                                    <ui:template>
                                        <m:ObjectNumber
                                            id="txtQuantity"
                                            number="{= ${print>RowType} === 'Group' ? ${print>TotalQuantity} : ${print>ProdOrderBasedQuantity} }"
											unit="{print>ProdOrderUnit}"
                                            state="None"
                                        />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colLabels"
                                    width="12%"
                                >
                                    <m:Label
                                        id="lblColLabels"
                                        text="{i18n>tableColumnLabels}"
                                    />
                                    <ui:template>
                                        <m:FlexBox id="labelsFlexBox" renderType="Bare" alignItems="Center">
                                            <m:Input
                                                id="subtotalLabelInput"
                                                value="{print>subtotalLabels}"
                                                type="Number"
                                                visible="{= ${print>RowType} === 'Group' }"
                                            />
                                            <m:ObjectNumber
                                                id="labelInput"
                                                number="{print>NumberOfLabels}"
                                                state="None"
                                                visible="{= ${print>RowType} === 'Item' }"
                                            />
                                        </m:FlexBox>
                                    </ui:template>
                                </ui:Column>
                                <ui:Column
                                    id="colPrinter"
                                    width="18%"
                                >
                                    <m:Label
                                        id="lblColPrinter"
                                        text="{i18n>labelPrinter}"
                                        required="true"
                                    />
                                    <ui:template>
                                        <m:MultiInput
                                            id="printerColInput"
                                            tokens="{print>DishLabelPrintTokens}"
                                            showValueHelp="true"
                                            valueHelpRequest="onPrinterValueHelp"
                                            tokenUpdate="onPrinterTokenUpdate"
                                            change="onPrinterManualInput"
                                            visible="{= ${print>RowType} === 'Group' }"
                                        >
                                            <m:tokens>
                                                <m:Token id="printerToken" key="{print>key}" text="{print>text}" />
                                            </m:tokens>
                                        </m:MultiInput>
                                    </ui:template>
                                </ui:Column>
                            </ui:columns>
                        </ui:Table>
                    </m:content>
                </m:Panel>
            </m:VBox>
        </m:content>
        <m:footer>
            <m:Toolbar
                id="dlgFooter"
                class="printDialogFooter"
            >
                <m:ToolbarSpacer id="footerSpacer" />
                <m:Button
                    id="PrintConfirmBtn"
                    text="{i18n>PrintConfirm}"
                    press="onPrintConfirm"
                    type="Emphasized"
                />
                <m:Button
                    id="closeBtn"
                    text="{i18n>buttonClose}"
                    press="onClosePrintDialog"
                />
            </m:Toolbar>
        </m:footer>
    </m:Dialog>
</core:FragmentDefinition>
