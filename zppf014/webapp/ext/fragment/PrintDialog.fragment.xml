<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog title="{i18n>PrintDialogTitle}">
        <content>
            <f:Form editable="true">
                <f:layout>
                    <f:ResponsiveGridLayout adjustLabelSpan="false" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false" />
                </f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{i18n>NumberOfCopies}">
                                <f:fields>
                                    <Select id="numberModeSelect" selectedKey="{print>/numberMode}">
                                        <items>
                                            <core:ListItem key="01" text="{i18n>ByItemInput}" />
                                            <core:ListItem key="02" text="{i18n>ByMassInput}" />
                                        </items>
                                    </Select>
                                    <Input id="massCopiesInput" type="Number" value="{print>/numberOfLabels}" visible="{= ${print>/numberMode} === '02'}"/>
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </content>
        <beginButton>
            <Button text="{i18n>Print}" press="onConfirmPrint" type="Emphasized" />
        </beginButton>
        <endButton>
            <Button press="onCloseDialog" text="{i18n>Close}" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
