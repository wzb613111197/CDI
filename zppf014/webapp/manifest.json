{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.cathaydining.zppf014",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "c36d1654-cba8-4807-bb72-b0f34add2e74"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_pp_manage_shopfloor_o4/srvd/sap/zsd_pp_manage_shopfloor_label/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cathaydining.zppf014.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "com.cathaydining.zppf014.ext.controller.ListReportExtension"
          }
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MANAGESHOPFLOORLABELList",
          "target": "MANAGESHOPFLOORLABELList"
        },
        {
          "pattern": "MANAGESHOPFLOORLABEL({key}):?query:",
          "name": "MANAGESHOPFLOORLABELObjectPage",
          "target": "MANAGESHOPFLOORLABELObjectPage"
        }
      ],
      "targets": {
        "MANAGESHOPFLOORLABELList": {
          "type": "Component",
          "id": "MANAGESHOPFLOORLABELList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MANAGESHOPFLOORLABEL",
              "variantManagement": "Page",
              "navigation": {
                "MANAGESHOPFLOORLABEL": {
                  "detail": {
                    "route": "MANAGESHOPFLOORLABELObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "beforeRebindTable": ".extension.com.cathaydining.zppf014.ext.controller.ListReportExtension.onBeforeRebindTable"
                  },
                  "columns": {
                    "PrintCopies": {
                      "header": "{i18n>PrintCopies}",
                      "template": "com.cathaydining.zppf014.ext.fragment.PrintCopies",
                      "availability": "Default",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::NumberofLabels"
                      },
                      "width": "9rem"
                    },
                    "PrintPrinter": {
                      "header": "{i18n>Printer}",
                      "template": "com.cathaydining.zppf014.ext.fragment.PrintPrinter",
                      "availability": "Default",
                      "position": {
                        "placement": "After",
                        "anchor": "PrintCopies"
                      },
                      "width": "15rem"
                    }
                  },
                  "actions": {
                    "Print": {
                      "press": ".extension.com.cathaydining.zppf014.ext.controller.ListReportExtension.onOpenPrintDialog",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "{i18n>Print}"
                    }
                  }
                }
              }
            }
          }
        },
        "MANAGESHOPFLOORLABELObjectPage": {
          "type": "Component",
          "id": "MANAGESHOPFLOORLABELObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/MANAGESHOPFLOORLABEL"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
