<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog title="Production Label Print">
        <content>
            <f:Form editable="true">
                <f:layout>
                    <f:ResponsiveGridLayout adjustLabelSpan="false" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false" />
                </f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="Output Device">
                                <f:fields>
                                    <Select selectedKey="{print>/selectedPrinter}" showSecondaryValues="true" items="{/PrinterVH}">
                                        <core:ListItem key="{Printer}" text="{Printer}" additionalText="{DeviceTypName}" tooltip="{DeviceTypName}" />
                                    </Select>
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="Number of copies">
                                <f:fields>
                                    <Select selectedKey="{print>/numberMode}">
                                        <items>
                                            <core:ListItem key="01" text="by item input" />
                                            <core:ListItem key="02" text="by mass input" />
                                        </items>
                                    </Select>
                                    <Input type="Number" value="{print>/numberOfLabels}" visible="{= ${print>/numberMode} === '02'}"/>
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </content>
        <beginButton>
            <Button text="Print" press="onPrint" type="Emphasized" />
        </beginButton>
        <endButton>
            <Button press="onCloseDialog" text="Close" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
