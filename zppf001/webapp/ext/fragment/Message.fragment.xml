<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="_IDGenDialog" title="Print Result" contentWidth="650px" contentHeight="50%" resizable="true" draggable="true" verticalScrolling="false">
        <content>
            <MessageView id="_IDGenMessageView1" items="{message>/}">
                <MessageItem type="{message>type}" title="{message>message}" subtitle="{message>additionalText}" description="{message>description}" />
            </MessageView>
        </content>
        <endButton>
            <Button id="_IDGenButton" press="onCloseDialog" text="Close" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

