<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:table="sap.ui.table"
	xmlns:rowmodes="sap.ui.table.rowmodes">
	<Dialog
		id="simulateConfirmResultDialog"
		title="{@i18n>FlightOrderMaterialAndDistribution}"
		contentWidth="98%"
		contentHeight="95%"
		resizable="true"
		draggable="true"
		stretch="true"
		verticalScrolling="false"
		horizontalScrolling="false"
		class="simulateConfirmResultDialog">
		<content>
			<VBox height="100%" width="100%" class="sapUiTinyMargin">
				<Title text="{@i18n>FlightOrderMaterialList}" level="H5" class="sapUiTinyMarginBottom"/>
				<table:Table
					id="confirmItemTable"
					rows="{ui>/confirmItems}"
					selectionMode="None"
					width="100%"
					height="42%"
					rowHeight="32"
					columnHeaderHeight="34"
					noData="{@i18n>msgNoSimulateData}">
					<table:rowMode>
						<rowmodes:Auto minRowCount="6"/>
					</table:rowMode>
					<table:columns>
						<table:Column width="5rem"><Label text="{@i18n>AirlineCode}"/><table:template><Text text="{ui>AirlineCode}" wrapping="false"/></table:template></table:Column>
						<table:Column width="7rem"><Label text="{@i18n>FlightNumber}"/><table:template><Text text="{ui>FlightNumber}" wrapping="false"/></table:template></table:Column>
						<table:Column width="9rem"><Label text="{@i18n>ScheduledDepartureDate}"/><table:template><Text text="{ui>ScheduledDepartureDate}" wrapping="false"/></table:template></table:Column>
						<table:Column width="5rem"><Label text="{@i18n>ItemNo}"/><table:template><Text text="{ui>ItemNo}" wrapping="false"/></table:template></table:Column>
						<table:Column width="7rem"><Label text="{@i18n>Sector}"/><table:template><Text text="{ui>Sector}" wrapping="false"/></table:template></table:Column>
						<table:Column width="7rem"><Label text="{@i18n>ServiceSequence}"/><table:template><Text text="{ui>ServiceSequence}" wrapping="false"/></table:template></table:Column>
						<table:Column width="6rem"><Label text="{@i18n>SeatClass}"/><table:template><Text text="{ui>SeatClass}" wrapping="false"/></table:template></table:Column>
						<table:Column width="6rem"><Label text="{@i18n>MealClass}"/><table:template><Text text="{ui>MealClass}" wrapping="false"/></table:template></table:Column>
						<table:Column width="8rem"><Label text="{@i18n>ItemCategory}"/><table:template><Text text="{ui>ItemCategory}" wrapping="false"/></table:template></table:Column>
						<table:Column width="7rem"><Label text="{@i18n>DishType}"/><table:template><Text text="{ui>DishType}" wrapping="false"/></table:template></table:Column>
						<table:Column width="6rem"><Label text="{@i18n>ChoiceNumber}"/><table:template><Text text="{ui>ChoiceNumber}" wrapping="false"/></table:template></table:Column>
						<table:Column width="8rem"><Label text="{@i18n>SpecialMealType}"/><table:template><Text text="{ui>SpecialMealType}" wrapping="false"/></table:template></table:Column>
						<table:Column width="10rem"><Label text="{@i18n>MaterialNumber}"/><table:template><Text text="{ui>MaterialNumber}" wrapping="false"/></table:template></table:Column>
						<table:Column width="10rem"><Label text="{@i18n>SimulatedCalculatedItemQuantity}"/><table:template><Text text="{ui>SimulatedCalculatedItemQuantity}" wrapping="false"/></table:template></table:Column>
						<table:Column width="5rem"><Label text="{@i18n>UnitOfMeasure}"/><table:template><Text text="{ui>UnitOfMeasure}" wrapping="false"/></table:template></table:Column>
					</table:columns>
				</table:Table>

				<Title text="{@i18n>Distribution}" level="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>
				<table:Table
					id="confirmDistributionTable"
					rows="{ui>/confirmDistribution}"
					selectionMode="None"
					width="100%"
					height="48%"
					rowHeight="32"
					columnHeaderHeight="34"
					noData="{@i18n>msgNoSimulateData}">
					<table:rowMode>
						<rowmodes:Auto minRowCount="8"/>
					</table:rowMode>
					<table:columns>
						<table:Column width="5rem"><Label text="{@i18n>Sequence}"/><table:template><Text text="{ui>Sequence}" wrapping="false"/></table:template></table:Column>
						<table:Column width="8rem"><Label text="{@i18n>ContainerId}"/><table:template><Text text="{ui>ContainerId}" wrapping="false"/></table:template></table:Column>
						<table:Column width="10rem"><Label text="{@i18n>ContainerMaterial}"/><table:template><Text text="{ui>ContainerMaterial}" wrapping="false"/></table:template></table:Column>
						<table:Column width="5rem"><Label text="{@i18n>ItemNo}"/><table:template><Text text="{ui>ItemNo}" wrapping="false"/></table:template></table:Column>
						<table:Column width="6rem"><Label text="{@i18n>Quantity}"/><table:template><Text text="{ui>Quantity}" wrapping="false"/></table:template></table:Column>
						<table:Column width="6rem"><Label text="{@i18n>MealClass}"/><table:template><Text text="{ui>MealClass}" wrapping="false"/></table:template></table:Column>
						<table:Column width="7rem"><Label text="{@i18n>ServiceSequence}"/><table:template><Text text="{ui>ServiceSequence}" wrapping="false"/></table:template></table:Column>
						<table:Column width="7rem"><Label text="{@i18n>Sector}"/><table:template><Text text="{ui>Sector}" wrapping="false"/></table:template></table:Column>
						<table:Column width="7rem"><Label text="{@i18n>DishType}"/><table:template><Text text="{ui>DishType}" wrapping="false"/></table:template></table:Column>
						<table:Column width="8rem"><Label text="{@i18n>SpecialMealType}"/><table:template><Text text="{ui>SpecialMealType}" wrapping="false"/></table:template></table:Column>
					</table:columns>
				</table:Table>
			</VBox>
		</content>
		<endButton>
			<Button text="{@i18n>Cancel}" press=".onCloseConfirmResultDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
