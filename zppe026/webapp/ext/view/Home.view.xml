<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    controllerName="com.cathaydining.zppe026.ext.controller.Home">
    <f:DynamicPage showFooter="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{@i18n>appTitle}"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="sapUiMediumMargin" width="auto">
                <Panel headerText="{@i18n>Option}" class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <RadioButtonGroup id="optionGroup" selectedIndex="0" class="sapUiSmallMarginBottom">
                            <RadioButton id="rbCompare" text="{@i18n>Option01}"/>
                            <RadioButton id="rbSimulate" text="{@i18n>Option02}"/>
                        </RadioButtonGroup>
                        <Button text="{@i18n>Execute}" type="Emphasized" press=".onExecute" class="sapUiSmallMarginTop"/>
                    </VBox>
                </Panel>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
