        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cathaydining.zppe025.i18n.i18n",
          "supportedLocales": [
            "",
            "zh_CN",
            "zh_TW"
          ],
          "fallbackLocale": ""
