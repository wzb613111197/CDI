                      "text": "{@i18n>AssignServingEquiment}",
                      "visible": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.visibleForAssignServingEquimentBtn"
                    }
                  }
                },
                "_Spe/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "creationMode": {
                      "name": "CreationDialog"
                    },
                    "enableFullScreen": true,
                    "selectAll": true,
                    "selectionMode": "Multi",
                    "type": "ResponsiveTable",
                    "widthIncludingColumnHeader": true
                  }
                },
                "_Git/@com.sap.vocabularies.UI.v1.SelectionPresentationVariant#table": {
                  "tableSettings": {
                    "enableFullScreen": true,
                    "selectAll": true,
                    "selectionMode": "Multi",
                    "type": "ResponsiveTable",
                    "widthIncludingColumnHeader": true
                  },
                  "columns": {
                    "CustomSeqColumn": {
                      "header": "{@i18n>Seq}",
                      "template": "com.cathaydining.zppe025.ext.fragment.MitSeqColumn",
                      "importance": "High",
                      "width": "6rem",
                      "availability": "Default",
                      "properties": [
                        "Seq"
                      ],
                      "position": {
                        "placement": "Replace",
                        "anchor": "DataField::Seq"
                      }
                    },
                    "DataField::Seq": {
                      "availability": "Hidden"
                    }
                  }
                },
                "_Git/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "enableFullScreen": true,
                    "selectAll": true,
                    "selectionMode": "Multi",
                    "type": "ResponsiveTable",
                    "widthIncludingColumnHeader": true
                  },
                  "columns": {
                    "CustomSeqColumn": {
                      "header": "{@i18n>Seq}",
                      "template": "com.cathaydining.zppe025.ext.fragment.MitSeqColumn",
                      "importance": "High",
                      "width": "6rem",
                      "availability": "Default",
                      "properties": [
                        "Seq"
                      ],
                      "position": {
                        "placement": "Replace",
                        "anchor": "DataField::Seq"
                      }
                    },
                    "DataField::Seq": {
                      "availability": "Hidden"
                    }
                  }
                },
                "_Dit/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "enableFullScreen": true,
                    "selectAll": true,
                    "selectionMode": "Multi",
