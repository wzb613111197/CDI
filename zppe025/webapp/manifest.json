          "target": "ZC_PP_LDGTEMP_HDRList"
        },
        {
          "pattern": "ZC_PP_LDGTEMP_HDR({key}):?query:",
          "name": "ZC_PP_LDGTEMP_HDRObjectPage",
          "target": "ZC_PP_LDGTEMP_HDRObjectPage"
        }
      ],
