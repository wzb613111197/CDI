                }
              },
              "content": {
                "header": {
                  "actions": {
                    "PreviewCalculationBtn": {
                      "press": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.onPreviewCalculation",
                      "enabled": "{= ${ui>/editMode} !== 'Editable'}",
                      "requiresSelection": false,
                      "text": "{@i18n>PreviewCalculation}",
                      "visible": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.visibleForPreviewCalculationBtn"
                    },
                    "RecurringSettingBtn": {
                      "press": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.onRecurringSetting",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{@i18n>RecurringSetting}",
                      "visible": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.visibleForRecurringSettingBtn"
                    }
