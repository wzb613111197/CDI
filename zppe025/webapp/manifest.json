                    "enableMassEdit": {
                      "ignoredFields": "Seq",
                      "operationGroupingMode": "ChangeSet"
                    }
                  },
                  "columns": {
                    "CustomSeqColumn": {
                      "header": "{@i18n>Seq}",
                      "template": "com.cathaydining.zppe025.ext.fragment.MitSeqColumn",
                      "importance": "High",
                      "width": "8rem",
                      "availability": "Default",
                      "properties": [
                        "Seq"
                      ],
                      "position": {
                        "placement": "Replace",
                        "anchor": "DataField::Seq"
                      }
                    },
                    "DataField::Seq": {
                      "availability": "Hidden"
                    }
                  },
                  "actions": {
                    "AssignLoadingEquiment": {
                      "press": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.onAssignLoadingEquiment",
                      "enabled": "{= ${ui>/editMode} === 'Editable'}",
                      "requiresSelection": true,
                      "text": "{@i18n>AssignLoadingEquiment}",
                      "visible": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.visibleForAssignLoadingEquimentBtn"
                    },
                    "AssignServingEquiment": {
                      "press": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.onAssignServingEquiment",
                      "enabled": "{= ${ui>/editMode} === 'Editable'}",
                      "requiresSelection": true,
                      "text": "{@i18n>AssignServingEquiment}",
                      "visible": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.visibleForAssignServingEquimentBtn"
                    }
                  }
                },
                "_Mit/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "enableFullScreen": true,
                    "selectAll": true,
                    "selectionMode": "Multi",
                    "type": "GridTable",
                    "widthIncludingColumnHeader": true,
                    "personalization": {
                      "filter": true,
                      "column": false,
                      "sort": true
                    },
                    "enableMassEdit": {
                      "ignoredFields": "Seq",
                      "operationGroupingMode": "ChangeSet"
                    }
                  },
                  "columns": {
                    "CustomSeqColumn": {
                      "header": "{@i18n>Seq}",
                      "template": "com.cathaydining.zppe025.ext.fragment.MitSeqColumn",
                      "importance": "High",
                      "width": "6rem",
                      "availability": "Default",
                      "properties": [
                        "Seq"
                      ],
                      "position": {
                        "placement": "Before",
                        "anchor": "DataField::AcftType"
                      }
                    },
                    "DataField::Seq": {
                      "availability": "Hidden"
                    }
                  },
                  "actions": {
                    "AssignLoadingEquiment": {
                      "press": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.onAssignLoadingEquiment",
                      "enabled": "{= ${ui>/editMode} === 'Editable'}",
                      "requiresSelection": true,
                      "text": "{@i18n>AssignLoadingEquiment}",
                      "visible": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.visibleForAssignLoadingEquimentBtn"
                    },
                    "AssignServingEquiment": {
                      "press": ".extension.com.cathaydining.zppe025.ext.controller.ObjectPageExtension.onAssignServingEquiment",
                      "enabled": "{= ${ui>/editMode} === 'Editable'}",
