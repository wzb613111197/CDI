          "type": "Component",
          "id": "ZC_PP_LDGTEMP_HDRList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_PP_LDGTEMP_HDR",
              "variantManagement": "Page",
              "navigation": {
                "ZC_PP_LDGTEMP_HDR": {
                  "detail": {
                    "route": "ZC_PP_LDGTEMP_HDRObjectPage"
                  }
