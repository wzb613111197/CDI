<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:mdc="sap.ui.mdc"
    xmlns:core="sap.ui.core">
    <Dialog
        id="loadingAssignmentDialog"
        title="{equipmentModel>/title}"
        contentWidth="40rem"
        resizable="true"
        draggable="true">
        <content>
            <mdc:Table
                id="loadingEquipmentTable"
                header="{equipmentModel>/title}"
                type="ResponsiveTable"
                autoBindOnInit="false"
                selectionMode="None"
                width="100%"
                delegate='{"name":"com/cathaydining/zppe025/ext/delegate/EquipmentAssignmentTableDelegate","payload":{"collectionPath":"/ZC_PP_MIT_LOAD_EQ","navPath":"_LoadEq","updateGroupId":"loadingEquipment"}}'>
                <mdc:actions>
                    <Button id="btnLoadingAdd" text="{i18n>Add}" type="Transparent" press="onEquipmentAddRow" enabled="{= ${ui>/editMode} === 'Editable'}"/>
                </mdc:actions>
                <!-- Columns are built by the delegate from the
                     UI.LineItem annotation of ZC_PP_MIT_LOAD_EQ. -->
            </mdc:Table>
        </content>
        <beginButton>
           <Button id="btnLoadingConfirm" text="{i18n>Confirm}" type="Emphasized" press="onEquipmentConfirm"/>
        </beginButton>
        <endButton>
           <Button id="btnLoadingClose" text="{i18n>Close}" press="onEquipmentClose"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
