<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
>
    <Dialog
        id="bomTreeDialog"
        title="{ui>/quotationDetail/bom/title}"
        contentWidth="72rem"
        contentHeight="42rem"
        draggable="true"
        resizable="true"
        horizontalScrolling="false"
        class="bomTreeDialog"
    >
        <content>
            <IconTabBar id="bomIconTabBar" expandable="false" class="sapUiNoContentPadding" applyContentPadding="false">
                <items>
                    <IconTabFilter id="bomTreeTab" text="{i18n>bomTreeTab}" icon="sap-icon://org-chart" key="tree">
                        <table:TreeTable
                            id="bomTreeTable"
                            rows="{path: 'ui>/quotationDetail/bom/tree', parameters: { arrayNames: ['children'], numberOfExpandedLevels: 1 }}"
                            selectionMode="None"
                            class="sapUiTinyMargin"
                        >
                            <table:rowMode>
                                <rowmodes:Auto id="bomTreeAutoRowMode" minRowCount="10" />
                            </table:rowMode>
                            <table:columns>
                                <table:Column id="bomColMaterial" width="12rem">
                                    <Label id="bomColMaterialLabel" text="{i18n>bomColMaterial}" />
                                    <table:template>
                                        <Text id="bomColMaterialText" text="{ui>Material}" wrapping="false" />
                                    </table:template>
                                </table:Column>
                                <table:Column id="bomColMaterialDesc" width="22rem">
                                    <Label id="bomColMaterialDescLabel" text="{i18n>bomColMaterialDesc}" />
                                    <table:template>
                                        <Text id="bomColMaterialDescText" text="{ui>MaterialDesc}" wrapping="false" />
                                    </table:template>
                                </table:Column>
                                <table:Column id="bomColLevel" width="5rem" hAlign="End">
                                    <Label id="bomColLevelLabel" text="{i18n>bomColLevel}" />
                                    <table:template>
                                        <Text id="bomColLevelText" text="{ui>BomLevel}" textAlign="End" />
                                    </table:template>
                                </table:Column>
                                <table:Column id="priceLevel" width="8rem" hAlign="End">
                                    <Label id="priceLevelLabel" text="{i18n>priceLevel}" />
                                    <table:template>
                                        <ObjectNumber id="priceLevelNumber"
                                            number="{ui>Price}" state="Information"
                                            unit="{ui>Currency}" />
                                    </table:template>
                                </table:Column>
                                <table:Column id="bomColValidFrom" width="9rem">
                                    <Label id="bomColValidFromLabel" text="{i18n>bomColValidFrom}" />
                                    <table:template>
                                        <Text id="bomColValidFromText" text="{ui>ValidFrom}" wrapping="false" />
                                    </table:template>
                                </table:Column>
                                <table:Column id="bomColValidTo" width="9rem">
                                    <Label id="bomColValidToLabel" text="{i18n>bomColValidTo}" />
                                    <table:template>
                                        <Text id="bomColValidToText" text="{ui>ValidTo}" wrapping="false" />
                                    </table:template>
                                </table:Column>
                            </table:columns>
                        </table:TreeTable>
                    </IconTabFilter>
                    <IconTabFilter id="bomPriceHistoryTab" text="{i18n>priceHistoryTitle}" icon="sap-icon://history" key="history">
                        <Table id="priceHistoryTable"
                            items="{ui>/quotationDetail/bom/priceHistory}"
                            growing="true"
                            growingThreshold="20"
                            noDataText="{i18n>noData}"
                            class="sapUiTinyMargin">
                            <columns>
                                <Column id="phColMaterial" width="10rem">
                                    <Text id="phColMaterialLabel" text="{i18n>bomColMaterial}" />
                                </Column>
                                <Column id="phColMaterialDesc" minScreenWidth="Tablet" demandPopin="true">
                                    <Text id="phColMaterialDescLabel" text="{i18n>bomColMaterialDesc}" />
                                </Column>
                                <Column id="phColCustomer" minScreenWidth="Desktop" demandPopin="true">
                                    <Text id="phColCustomerLabel" text="{i18n>customerLabel}" />
                                </Column>
                                <Column id="phColPrice" hAlign="End" width="8rem">
                                    <Text id="phColPriceLabel" text="{i18n>priceLevel}" />
                                </Column>
                                <Column id="phColPricingUnit" hAlign="End" width="8rem" minScreenWidth="Desktop" demandPopin="true">
                                    <Text id="phColPricingUnitLabel" text="{i18n>phColPricingUnit}" />
                                </Column>
                                <Column id="phColValidFrom" width="9rem" minScreenWidth="Tablet" demandPopin="true">
                                    <Text id="phColValidFromLabel" text="{i18n>bomColValidFrom}" />
                                </Column>
                                <Column id="phColValidTo" width="9rem" minScreenWidth="Tablet" demandPopin="true">
                                    <Text id="phColValidToLabel" text="{i18n>bomColValidTo}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="phListItem" type="Inactive">
                                    <cells>
                                        <Text id="phCellMaterial" text="{ui>material}" wrapping="false" />
                                        <Text id="phCellMaterialDesc" text="{ui>MaterialDesc}" />
                                        <Text id="phCellCustomer" text="{ui>Customer}" wrapping="false" />
                                        <ObjectNumber id="phCellPrice" number="{ui>Price}" unit="{ui>Currency}" state="Information" />
                                        <ObjectNumber id="phCellPricingUnit" number="{ui>PricingUnit}" unit="{ui>Unit}" state="None" />
                                        <Text id="phCellValidFrom" text="{ui>ValidFrom}" wrapping="false" />
                                        <Text id="phCellValidTo" text="{ui>ValidTo}" wrapping="false" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
        <endButton>
            <Button id="bomTreeCloseButton" text="{i18n>qdClose}" type="Emphasized" press="onCloseBomTreeDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
