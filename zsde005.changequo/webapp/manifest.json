{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.cathaydining.zsde005.changequo",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "b8e0498c-6196-46bf-88d4-836f1dd5c592"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_sd_qt_load_temp_o4/srvd/sap/zsd_sd_qt_load_temp/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cathaydining.zsde005.changequo.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_SD_QUERY_QT_HEADList",
          "target": "ZC_SD_QUERY_QT_HEADList"
        },
        {
          "pattern": "ZC_SD_QUERY_QT_HEAD({key}):?query:",
          "name": "ZC_SD_QUERY_QT_HEADObjectPage",
          "target": "ZC_SD_QUERY_QT_HEADObjectPage"
        }
      ],
      "targets": {
        "ZC_SD_QUERY_QT_HEADList": {
          "type": "Component",
          "id": "ZC_SD_QUERY_QT_HEADList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_SD_QUERY_QT_HEAD",
              "variantManagement": "Page",
              "navigation": {
                "ZC_SD_QUERY_QT_HEAD": {
                  "detail": {
                    "route": "ZC_SD_QUERY_QT_HEADObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ZC_SD_QUERY_QT_HEADObjectPage": {
          "type": "Component",
          "id": "ZC_SD_QUERY_QT_HEADObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_SD_QUERY_QT_HEAD",
              "controlConfiguration": {
                "_Item/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "enableExport": false,
                    "enableFullScreen": true,
                    "personalization": {
                      "filter": true,
                      "group": true,
                      "sort": true,
                      "column": false
                    },
                    "selectAll": true,
                    "selectionMode": "Multi",
                    "type": "GridTable",
                    "widthIncludingColumnHeader": true,
                    "enableMassEdit": {
                      "visibleFields": "LabourMMAdjFix,LabourSellRate"
                    }
                  },
                  "actions": {
                    "ExportItems": {
                      "visible": true,
                      "requiresSelection": false,
                      "press": ".extension.com.cathaydining.zsde005.changequo.ext.controller.ObjectPageExtension.onItemExport",
                      "text": "{@i18n>exportExcelButton}"
                    },
                    "SellingMatrix": {
                      "visible": true,
                      "requiresSelection": true,
                      "press": ".extension.com.cathaydining.zsde005.changequo.ext.controller.ObjectPageExtension.onSellingMatrix",
                      "text": "{@i18n>qdSellingMatrix}"
                    },
                    "AviQuotation": {
                      "visible": true,
                      "requiresSelection": true,
                      "press": ".extension.com.cathaydining.zsde005.changequo.ext.controller.ObjectPageExtension.onAviQuotation",
                      "text": "{@i18n>qdAviQuotation}"
                    },
                    "NonAviQuotation": {
                      "visible": true,
                      "requiresSelection": true,
                      "press": ".extension.com.cathaydining.zsde005.changequo.ext.controller.ObjectPageExtension.onNonAviQuotation",
                      "text": "{@i18n>qdNonAviQuotation}"
                    }
                  },
                  "columns": {
                    "ViewItem": {
                      "header": "{@i18n>qdColView}",
                      "width": "4rem",
                      "template": "com.cathaydining.zsde005.changequo.ext.fragment.ViewItemColumn",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataField::Item"
                      },
                      "properties": [
                        "Material"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "com.cathaydining.zsde005.changequo.ext.controller.ObjectPageExtension"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
