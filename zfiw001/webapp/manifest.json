{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.cathaydining.zfiw001",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "e0d93f44-75bb-429e-876d-c742a087dcc4"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_fi_appr_hdr_o4/srvd/sap/zsd_fi_appr_hdr/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cathaydining.zfiw001.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        },
        "routerClass": "sap.f.routing.Router"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_FI_APPR_HDRList",
          "target": [
            "ZC_FI_APPR_HDRList"
          ]
        },
        {
          "pattern": "ZC_FI_APPR_HDR({key}):?query:",
          "name": "ZC_FI_APPR_HDRObjectPage",
          "target": [
            "ZC_FI_APPR_HDRList",
            "ZC_FI_APPR_HDRObjectPage"
          ]
        },
        {
          "pattern": "ZC_FI_APPR_HDR({key})/_CostCenter({key2}):?query:",
          "name": "ZC_FI_APPR_CCObjectPage",
          "target": [
            "ZC_FI_APPR_HDRList",
            "ZC_FI_APPR_HDRObjectPage",
            "ZC_FI_APPR_CCObjectPage"
          ]
        }
      ],
      "targets": {
        "ZC_FI_APPR_HDRList": {
          "type": "Component",
          "id": "ZC_FI_APPR_HDRList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_FI_APPR_HDR",
              "variantManagement": "Page",
              "navigation": {
                "ZC_FI_APPR_HDR": {
                  "detail": {
                    "route": "ZC_FI_APPR_HDRObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "widthIncludingColumnHeader": true
                  }
                }
              },
              "defaultTemplateAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#table"
            }
          },
          "controlAggregation": "beginColumnPages",
          "contextPattern": ""
        },
        "ZC_FI_APPR_HDRObjectPage": {
          "type": "Component",
          "id": "ZC_FI_APPR_HDRObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_FI_APPR_HDR",
              "controlConfiguration": {
                "_CostCenter/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "CreationDialog"
                    },
                    "enableMassEdit": {},
                    "enableFullScreen": true
                  }
                }
              },
              "navigation": {
                "ZC_FI_APPR_CC": {
                  "detail": {
                    "route": "ZC_FI_APPR_CCObjectPage"
                  }
                }
              }
            }
          },
          "controlAggregation": "midColumnPages",
          "contextPattern": "/ZC_FI_APPR_HDR({key})"
        },
        "ZC_FI_APPR_CCObjectPage": {
          "type": "Component",
          "id": "ZC_FI_APPR_CCObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_FI_APPR_HDR/_CostCenter",
              "controlConfiguration": {
                "_Approver/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "CreationDialog",
                      "creationFields": "Approver,ValidFrom,ValidTo"
                    },
                    "widthIncludingColumnHeader": true,
                    "enableFullScreen": true,
                    "enableMassEdit": true
                  }
                }
              }
            }
          },
          "controlAggregation": "endColumnPages",
          "contextPattern": "/ZC_FI_APPR_HDR({key})/_CostCenter({key2})"
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
