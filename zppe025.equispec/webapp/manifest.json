                    },
                    "selectionMode": "Multi",
                    "selectAll": true,
                    "type": "ResponsiveTable",
                    "widthIncludingColumnHeader": true,
                    "enableFullScreen": true,
                    "enablePaste": false,
                    "personalization": {
                      "filter": true,
                      "group": true
                    },
                    "quickVariantSelection": {
                      "showCounts": true
                    }
                  }
                }
              }
            }
          }
        }
      }
