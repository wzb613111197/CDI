{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.cathaydining.zppe020",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "78bd9994-cd4a-4e0c-a66a-203e50626d7b"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_pp_cn_hdr_o4/srvd/sap/zsd_pp_cn/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
     "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "com.cathaydining.zppe020.ext.controller.ListReportExtension"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "com.cathaydining.zppe020.ext.controller.ObjectPageExtension"
          }
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cathaydining.zppe020.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
          {
            "uri": "css/style.css"
          }
        ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_PP_CN_HDRList",
          "target": "ZC_PP_CN_HDRList"
        },
        {
          "pattern": "ZC_PP_CN_HDR({key}):?query:",
          "name": "ZC_PP_CN_HDRObjectPage",
          "target": "ZC_PP_CN_HDRObjectPage"
        }
      ],
      "targets": {
        "ZC_PP_CN_HDRList": {
          "type": "Component",
          "id": "ZC_PP_CN_HDRList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_PP_CN_HDR",
              "variantManagement": "Page",
              "navigation": {
                "ZC_PP_CN_HDR": {
                  "detail": {
                    "route": "ZC_PP_CN_HDRObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "widthIncludingColumnHeader": true
                  }
                }
              }
            }
          }
        },
        "ZC_PP_CN_HDRObjectPage": {
          "type": "Component",
          "id": "ZC_PP_CN_HDRObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_PP_CN_HDR"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
