      "supportedLocales": [
        "",
        "zh",
        "zh-CN",
        "zh-TW"
      ]
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.21.0",
      "toolsId": "6e9a4ebe-3f8a-4c7a-84b3-87930405066d"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_pp_prd_perfrm_dashboard_o4/srvd/sap/zsd_pp_prod_perform_dashboard/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.comp": {},
        "sap.ui.table": {},
        "sap.ui.mdc": {},
        "sap.fe.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cathaydining.zppr004.i18n.i18n",
          "supportedLocales": [
            "",
            "en",
            "zh",
            "zh_CN",
            "zh_TW"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": [
            "",
            "en",
            "zh",
            "zh_CN",
            "zh_TW"
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "Home",
          "target": "Home"
        },
        {
          "pattern": "Dashboard:?query:",
          "name": "Dashboard",
          "target": "Dashboard"
        },
        {
          "pattern": "ZI_PP_PPD_PROD_DETAIL:?query:",
          "name": "ZI_PP_PPD_PROD_DETAILList",
          "target": "ZI_PP_PPD_PROD_DETAILList"
        },
        {
          "pattern": "ZI_PP_PPD_FLIGHT_ORDER_DETAIL:?query:",
          "name": "ZI_PP_PPD_FLIGHT_ORDER_DETAILList",
          "target": "ZI_PP_PPD_FLIGHT_ORDER_DETAILList"
        }
      ],
      "targets": {
        "Home": {
          "type": "Component",
          "id": "Home",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {},
              "viewName": "com.cathaydining.zppr004.ext.view.Main"
            }
          }
        },
        "Dashboard": {
          "type": "Component",
          "id": "Dashboard",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {},
              "viewName": "com.cathaydining.zppr004.ext.view.Main"
            }
          }
        },
        "ZI_PP_PPD_PROD_DETAILList": {
          "type": "Component",
          "id": "ZI_PP_PPD_PROD_DETAILList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZI_PP_PPD_PROD_DETAIL",
              "variantManagement": "Page",
              "initialLoad": "Auto",
              "navigation": {},
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectionMode": "None",
                    "widthIncludingColumnHeader": true
                  }
                }
              }
            }
          }
        },
        "ZI_PP_PPD_FLIGHT_ORDER_DETAILList": {
          "type": "Component",
          "id": "ZI_PP_PPD_FLIGHT_ORDER_DETAILList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZI_PP_PPD_FLIGHT_ORDER_DETAIL",
              "variantManagement": "Page",
              "initialLoad": "Auto",
              "navigation": {},
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectionMode": "None",
                    "widthIncludingColumnHeader": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "com.cathaydining.zppr004.ext.controller.ListReportExtension"
          }
        }
      }
    },
    "flexBundle": false
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
